# ═══════════════════════════════════════════════════════════════
#  ConstructAI — Backend Environment Configuration
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Groq AI API ───────────────────────────────────────────────
# Obtain your free key at https://console.groq.com
# Required for all AI features (multimodal + text).
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models (Optional overrides)
# Supported text model: openai/gpt-oss-120b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Supported multimodal vision model: qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional Groq API base URL override (leave blank for default https://api.groq.com)
# GROQ_BASE_URL=https://api.groq.com

# ─── Server ────────────────────────────────────────────────────
# Port the FastAPI/Uvicorn server listens on.
PORT=8000

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Wildcards are not allowed.
# In development this is the Vite dev server.
# In production replace with your actual domain(s).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── App Settings ──────────────────────────────────────────────
# "development" enables verbose error traces in responses.
# "production" suppresses internal detail for security.
APP_ENV=development

# ─── File Upload Limits ────────────────────────────────────────
# Maximum image size accepted by multimodal endpoints (megabytes).
MAX_IMAGE_SIZE_MB=10
