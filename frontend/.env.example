# ═══════════════════════════════════════════════════════════════
#  ConstructAI — Frontend Environment Configuration
#  Copy this file to .env and fill in your real values.
#  Variables MUST be prefixed with VITE_ to be exposed to the
#  browser bundle by Vite's import.meta.env mechanism.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Backend API ───────────────────────────────────────────────
# API base URL, including /api. The default Vite proxy is used when unset.
# Set this to your deployed API URL when building for production.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Frontend environment values are public in the browser bundle; never put secrets here.
